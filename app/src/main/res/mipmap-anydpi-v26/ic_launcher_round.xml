<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <!-- The launcher masks an adaptive icon to a shape and only guarantees the centre ~66% is
         visible; anything outside is cropped. The logo artwork fills nearly its whole canvas, so
         it is inset by 20% on every side (drawn at 60% size) to keep the entire crystal inside
         the safe zone instead of having its edges cut off. -->
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="20%" />
    </foreground>
    <monochrome>
        <inset
            android:drawable="@drawable/ic_launcher_monochrome"
            android:inset="20%" />
    </monochrome>
</adaptive-icon>
